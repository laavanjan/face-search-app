# AWS - leave blank to use local filesystem storage + InsightFace-only detection
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Qdrant - leave blank for in-memory (dev) or set to local docker: http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=faces

# Detection quality thresholds
MIN_FACE_SIZE=40
MIN_DET_SCORE=0.5

# Local storage paths (used when AWS is blank)
LOCAL_PHOTO_DIR=./data/photos

# CORS
ALLOWED_ORIGINS=http://localhost:3000
