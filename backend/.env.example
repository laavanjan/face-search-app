# AWS - leave blank to use local filesystem storage + InsightFace-only detection.
# Setting AWS sends face images to AWS: read docs/privacy/cross-border-transfer-assessment.md first.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Qdrant - leave blank for in-memory (dev) or set to local docker: http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=faces

# Model identity + detection thresholds. Changing any of these pauses indexing and
# search until an admin approves the change (docs/governance/change-management.md).
FACE_MODEL_NAME=buffalo_l
FACE_DET_SIZE=640
MIN_FACE_SIZE=40
MIN_DET_SCORE=0.5

# Local storage paths (used when AWS is blank)
LOCAL_PHOTO_DIR=./data/photos
GOVERNANCE_DB_PATH=./data/governance.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- Access control --------------------------------------------------------
# name:role[+role]:token, comma-separated. Roles: viewer, operator, reviewer, admin.
# Tokens may be "sha256:<hex digest>" instead of the raw secret.
# REPLACE these example tokens before sharing the deployment with anyone.
API_KEYS=olivia:operator:change-me-operator,rita:reviewer:change-me-reviewer,adam:admin:change-me-admin

# --- Human oversight -------------------------------------------------------
REQUIRE_INDEX_REVIEW=true
ALLOW_SELF_REVIEW=false
SEARCH_MIN_THRESHOLD=0.35
SEARCH_MAX_LIMIT=50

# --- Privacy ---------------------------------------------------------------
# consent | contract | legitimate_interest | legal_obligation | vital_interests | public_task
DATA_PROCESSING_LEGAL_BASIS=consent
PRIVACY_NOTICE_URL=/privacy
PRIVACY_NOTICE_VERSION=2026-10-14

# --- Retention (days) ------------------------------------------------------
PHOTO_RETENTION_DAYS=90
REVIEW_CASE_RETENTION_DAYS=30
APPEAL_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=365
RETENTION_SWEEP_INTERVAL_MINUTES=60

# --- Appeals SLA (days) ----------------------------------------------------
APPEAL_ACK_DAYS=2
APPEAL_RESOLUTION_DAYS=30

# --- Reliability -----------------------------------------------------------
QDRANT_TIMEOUT_SECONDS=20
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=20
AWS_MAX_ATTEMPTS=3
REMOTE_RETRY_ATTEMPTS=3
INFERENCE_TIMEOUT_SECONDS=60

# Test-only. Never enable in a real deployment (docs/privacy/synthetic-data.md).
SYNTHETIC_DATA_ENABLED=false
